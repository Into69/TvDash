<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="27dp"
    android:paddingEnd="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="H:mm"
                android:textColor="@color/text"
                android:textSize="52sp" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, MMMM d"
                android:format24Hour="EEEE, MMMM d"
                android:textColor="@color/text_dim"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <!-- Display only (location and station are set from the Home screen tile). Mirrors the
                 clock: one big reading, with short detail lines beside it. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/weather_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text"
                    android:textSize="52sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:orientation="vertical">

                    <!-- "Clear · Feels like 1°", or a message when weather can't be shown. -->
                    <TextView
                        android:id="@+id/weather_now"
                        style="@style/WeatherLine"
                        android:textColor="@color/text" />

                    <!-- "High 9°  Low -2° · Rain/snow 4%" -->
                    <TextView
                        android:id="@+id/weather_today"
                        style="@style/WeatherLine" />

                    <!-- "Arnprior · Calm · Humidity 77%" -->
                    <TextView
                        android:id="@+id/weather_place"
                        style="@style/WeatherLine" />
                </LinearLayout>
            </LinearLayout>

            <!-- Next few hours, e.g. "7 PM ☁️ 5°". -->
            <TextView
                android:id="@+id/hourly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingEnd="20dp"
                android:textColor="@color/text_dim"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Now playing: shown while a media app (Spotify…) is playing or paused on the TV. -->
    <LinearLayout
        android:id="@+id/now_playing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/np_art"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/tile_bg"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- Takes whatever width the art and buttons leave, so long titles ellipsize instead of
             pushing the buttons off screen; the focus chip still hugs the text. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/np_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/chip_bg"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/np_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/np_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_dim"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <ImageButton
            android:id="@+id/np_prev"
            style="@style/NowPlayingButton"
            android:contentDescription="@string/np_previous"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/np_play"
            style="@style/NowPlayingButton"
            android:contentDescription="@string/np_play"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/np_next"
            style="@style/NowPlayingButton"
            android:contentDescription="@string/np_next"
            android:src="@drawable/ic_next" />

        <ImageButton
            android:id="@+id/np_screensaver"
            style="@style/NowPlayingButton"
            android:layout_marginStart="24dp"
            android:contentDescription="@string/np_screensaver"
            android:src="@drawable/ic_screensaver" />
    </LinearLayout>

    <!-- Separates the clock/weather header from the tiles. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="10dp"
        android:background="@color/divider" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="8dp"
        android:paddingBottom="27dp"
        android:scrollbars="none">

        <dev.tvdash.launcher.TileGrid
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>
</LinearLayout>
